    function arrayHandleFun($array, $isRepeat = false)
    {

        foreach ($array as $key => $value)
        {
            if ($value === null)
            {
                $array[$key] = "";
            }
            else if (is_array($value))
            {
                if (empty($value))
                {
                    //$array[$key] = "";
                    
                }
                else
                {
                    $array[$key] = SELF::arrayHandleFun($value);
                }
            }
        }
        if (!$isRepeat)
        {
            $array = SELF::arrayHandleFun($array, true);
        }
        return $array;
    }
    
